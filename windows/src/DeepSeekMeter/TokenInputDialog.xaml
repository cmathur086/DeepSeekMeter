<Window x:Class="DeepSeekMeter.TokenInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste Token"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <StackPanel Margin="18">
        <TextBlock Text="Paste platform token" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="Sign in at platform.deepseek.com, then copy the token from your browser's developer tools (Application → Local Storage → userToken) and paste it here. The token is kept only on this machine and is never sent to any third party."
                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid Margin="0,12,0,0">
            <PasswordBox x:Name="TokenBox" Height="32" FontSize="12" />
            <TextBox x:Name="TokenVisibleBox" Height="32" FontSize="12" Visibility="Collapsed" />
        </Grid>
        <CheckBox x:Name="ShowTokenBox" Content="Show token" FontSize="11" Foreground="#666666"
                  Checked="OnShowTokenChanged" Unchecked="OnShowTokenChanged" Margin="0,6,0,0" />
        <Grid Margin="0,12,0,0">
            <TextBlock x:Name="HintText" Text="" FontSize="11" Foreground="#C05621" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" FontSize="11" Padding="14,5" Background="Transparent" BorderBrush="#CCCCCC"
                        Foreground="#333333" Cursor="Hand" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save" FontSize="11" Padding="14,5" Background="#4D6BFE" Foreground="White"
                        BorderThickness="0" Cursor="Hand" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
